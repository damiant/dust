{
  "name": "dust",
  "version": "0.0.1",
  "author": "Damian Tarnawsky",
  "homepage": "https://dust.events",
  "type": "module",
  "scripts": {
    "start": "ng serve --port 0",
    "build-prod": "NG_BUILD_OPTIMIZE_CHUNKS=1 ng build --configuration=production  && bun scripts/copy-admin.ts && bun run sentry:sourcemaps",
    "build-offline-mango": "ng build --configuration=offline --base-href=/dust/",
    "build-offline-part2": "bun scripts/copy-online.ts && cp -r /Users/damiantarnawsky/Code/dust-admin/burning-man/dist/* /Users/damiantarnawsky/Code/dust/www/browser/data/static/",
    "copy-offline": "rsync -avh www/browser/* /Volumes/stuff --progress",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "copy-admin": "bun scripts/copy-admin.ts",
    "download": "npx tsx scripts/download.ts no 2017 2018 2019 2022 2023",
    "download-this-year": "npx tsx scripts/download.ts yes 2024",
    "deploy-preview-app": "npm run build --configuration=production && netlify deploy --prod --dir=www/browser",
    "rsl": "npx tsx scripts/rsl.ts",
    "restrooms": "npx tsx scripts/restrooms.ts",
    "precommit": "ng lint",
    "lint": "ng lint",
    "prettify": "prettier \"**/*.{ts,html}\" --write",
    "format": "prettier \"src/**/*.{ts,html,css,scss,json,md}\" --write",
    "prepare": "husky",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org none-q2r --project dust ./www/browser && sentry-cli sourcemaps upload --org none-q2r --project dust ./www/browser"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "22",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/router": "22.1.2",
    "@angular/service-worker": "22.1.2",
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/barcode-scanner": "^3.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capacitor/text-zoom": "8.0.1",
    "@capawesome/capacitor-app-update": "8.0.3",
    "@ionic/angular": "8.8.13",
    "@sentry/angular": "9.46.0",
    "@sentry/capacitor": "^2.4.1",
    "@sentry/cli": "^2.58.6",
    "@types/qrcode": "^1.5.6",
    "@webnativellc/capacitor-filesharer": "7.1.0",
    "@webnativellc/capacitor-navigation-bar": "^7.1.0",
    "@webnativellc/capacitor-print-webview": "7.1.0",
    "capacitor-plugin-safe-area": "4.0.0",
    "cordova-plugin-device-orientation": "3.0.0",
    "fuse.js": "7.0.0",
    "idb-keyval": "6.2.6",
    "ionicons": "^7.4.0",
    "ngxtension": "7.0.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "three": "0.185.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.4",
    "@angular-eslint/builder": "22",
    "@angular-eslint/eslint-plugin": "22",
    "@angular-eslint/eslint-plugin-template": "22",
    "@angular-eslint/schematics": "22",
    "@angular-eslint/template-parser": "22",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/language-service": "22.1.2",
    "@capacitor/cli": "8.4.2",
    "@ionic/angular-toolkit": "12.3.0",
    "@types/node": "22.13.10",
    "@types/three": "0.178.1",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "@vitest/ui": "4.0.18",
    "baseline-browser-mapping": "^2.11.8",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.5.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-unused-imports": "4.3.0",
    "husky": "9.1.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^27.4.0",
    "lint-staged": "16.2.7",
    "native-run": "^2.0.3",
    "node-fetch": "^3.3.2",
    "prettier": "3.8.1",
    "sharp": "0.35.3",
    "tsx": "4.7.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "description": "An offline guide for the events, theme camps & art of Burning Man.",
  "browserslist": [
    "Chrome >=107",
    "ChromeAndroid >=60",
    "Firefox >=106",
    "Edge >=107",
    "Safari >=16.1",
    "iOS >=16.1"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "bunx lint-staged && bun run lint && bun run format",
      "pre-push": "bun run lint"
    }
  },
  "lint-staged": {
    "*.{css,html,js,jsx,scss,ts,tsx}": [
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  }
}
